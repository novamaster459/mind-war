{
  "name": "war-room-tactics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "War Room Tactics - a turn-based tactical war board game PWA inspired by C&C Generals",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc -b && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsx scripts/test-logic.mts",
    "test:engine": "tsx scripts/test-engine.mts",
    "test:ai": "tsx scripts/test-ai.mts",
    "test:multiplayer": "tsx scripts/test-multiplayer.mts",
    "lint": "eslint ."
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
